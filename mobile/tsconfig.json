{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@api": ["./src/api/index.ts"],
      "@api/*": ["./src/api/*"],
      "@auth": ["./src/auth/index.ts"],
      "@auth/*": ["./src/auth/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "node_modules"
  ]
}
