DATABASE_URL=postgresql://user:password@localhost:5432/workout_planner
PORT=3005

# Auth (required for login/register)
JWT_ACCESS_SECRET=change-me-in-dev-only
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
RESET_TOKEN_EXPIRES_HOURS=1
RESET_LINK_BASE=http://localhost:5173/reset-password
BCRYPT_ROUNDS=12

# Waitlist notice. Leave SMTP_HOST empty to save signups without sending mail.
# Mail goes only to WAITLIST_NOTIFY_TO. The person who signed up gets nothing.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=the Gmail address,
# SMTP_PASS=an app password (Google account → Security → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WAITLIST_NOTIFY_TO=
# Replaces the default https://grillia.github.io when set. Comma-separated.
# WAITLIST_CORS_ORIGINS=https://grillia.github.io,http://localhost:4321
